# DashkaRecord v2.0.0-alpha
# Environment Configuration
# TASK15 - Database Integration Added

# ====================
# DATABASE (REQUIRED)
# ====================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local: postgresql://postgres:password@localhost:5432/dashkarecord
# Render: Get from Render Dashboard → Database → Internal Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/dashkarecord?schema=public"

# ====================
# AI FEATURES (OPTIONAL)
# ====================

# OpenAI API key for Whisper transcription
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# DeepSeek API key for translation
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY="sk-..."

# ====================
# EXTERNAL INTEGRATIONS (OPTIONAL)
# ====================

# Solar Core ERP API endpoint
SOLAR_CORE_API_URL="https://solar-core.example.com/api"
SOLAR_CORE_API_KEY="your-api-key-here"

# ====================
# FEATURE FLAGS
# ====================

# Enable AI transcription (requires OPENAI_API_KEY)
ENABLE_AI_TRANSCRIPTION="false"

# Enable AI translation (requires DEEPSEEK_API_KEY)
ENABLE_AI_TRANSLATION="false"

# Enable Solar Core sync (requires SOLAR_CORE_API_*)
ENABLE_SOLAR_SYNC="false"

# Enable MP4 conversion (requires FFmpeg)
ENABLE_MP4_CONVERSION="false"

# ====================
# DEPLOYMENT (OPTIONAL)
# ====================

# Next.js configuration
NODE_ENV="development"
PORT="3002"

# Deployment platform
PLATFORM="render"  # Options: render, railway, fly

# ====================
# NOTES
# ====================

# 1. DATABASE_URL is REQUIRED for app to work
# 2. All AI features work without API keys, but with limitations
# 3. Feature flags default to "false" for cost control
# 4. Update .gitignore to exclude .env file
# 5. For production, use Render/Railway environment variables UI
